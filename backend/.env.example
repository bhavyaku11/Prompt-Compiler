# Prompt Compiler — Backend Environment Template
# Copy this file to .env for local backend development.
# Never commit real secrets to version control.

# Application Configuration
APP_NAME="Prompt Compiler"
APP_VERSION="0.1.0"

# Local Ollama AI Settings
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3:0.6b"
OLLAMA_TIMEOUT=120.0

# Vector Knowledge Base & Embeddings
EMBEDDING_PROVIDER="ollama"
EMBEDDING_MODEL="nomic-embed-text"
EMBEDDING_DIMENSION=768
KNOWLEDGE_RETRIEVAL_ENABLED=true
KNOWLEDGE_MIN_RELEVANCE_SCORE=0.5
KNOWLEDGE_RETRIEVAL_TOP_K=3
KNOWLEDGE_MAX_CONTEXT_CHARS=2000

# Persistence & Storage (defaults to ./data/prompt_compiler.db in dev mode)
# DATABASE_URL="sqlite:///./data/prompt_compiler.db"
# PROMPT_COMPILER_DATA_DIR=""
DATABASE_ECHO=false

# Desktop / Server Runtime Settings
DESKTOP_MODE=false
DESKTOP_BACKEND_HOST="127.0.0.1"
DESKTOP_BACKEND_PORT=8000

# Clerk Authentication (Desktop mode uses offline RSA public key validation by default)
# CLERK_SECRET_KEY="<set-locally-if-required>"
# CLERK_JWT_KEY="<custom-public-key-pem-if-overriding-default>"
# CLERK_PUBLISHABLE_KEY="<your-clerk-publishable-key>"
CLERK_AUTHORIZED_PARTIES="http://localhost:5173,tauri://localhost,http://tauri.localhost"
